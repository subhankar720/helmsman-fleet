#############################################################
# Helmsman Sanity v9
# Configuration File
#############################################################

############################
# Cluster Contexts
############################

HUB_CONTEXT="kind-helmsman-hub"
SPOKE_CONTEXT="kind-helmsman-onprem"

############################
# Namespaces
############################

ARGO_NAMESPACE="argocd"
KEYCLOAK_NAMESPACE="keycloak"
VAULT_NAMESPACE="vault"
ESO_NAMESPACE="external-secrets"
APP_NAMESPACE="sample-app"

############################
# Applications
############################

KEYCLOAK_APP="platform-keycloak"
VAULT_APP="platform-vault"
ESO_APP="platform-eso"
SAMPLE_APP="sample-app-helmsman-onprem"

############################
# Services
############################

KEYCLOAK_SERVICE="keycloak"
VAULT_SERVICE="vault"

############################
# NodePorts
############################

KEYCLOAK_NODEPORT=30081
VAULT_NODEPORT=30082

############################
# Retry Settings
############################

RETRY_COUNT=20
RETRY_INTERVAL=3

WAIT_TIMEOUT=300

############################
# Curl Settings
############################

CONNECT_TIMEOUT=3
CURL_TIMEOUT=5

############################
# Logging
############################

LOG_LEVEL="INFO"

LOG_DIR="./logs"
REPORT_DIR="./reports"

############################
# Runtime
############################

TMP_DIR="/tmp"

############################
# Feature Flags
############################

ENABLE_NETWORK_RECOVERY=true

ENABLE_ARGOCD_REPAIR=true

ENABLE_SECRET_REPAIR=true

ENABLE_APP_RESTART=true

ENABLE_COREDNS_RESTART=true

ENABLE_KUBEPROXY_RESTART=true

ENABLE_DEBUG=false

DRY_RUN=false

# Kind Control Plane Containers
HUB_CONTROL_PLANE_CONTAINER="helmsman-hub-control-plane"

SPOKE_CONTROL_PLANE_CONTAINER="helmsman-spoke-control-plane"

################################################################################
# Deployment Configuration
################################################################################

# Hub Cluster
ARGOCD_SERVER_DEPLOYMENT="argocd-server"
KEYCLOAK_DEPLOYMENT="keycloak"
VAULT_DEPLOYMENT="vault"

# Spoke Cluster
OAUTH2_PROXY_DEPLOYMENT="oauth2-proxy"
SAMPLE_APP_DEPLOYMENT="sample-app"

################################################################################
# Service Configuration
################################################################################

# Hub Cluster
ARGOCD_SERVICE="argocd-server"
KEYCLOAK_SERVICE="keycloak"
VAULT_SERVICE="vault"

# Spoke Cluster
OAUTH2_PROXY_SERVICE="oauth2-proxy"
SAMPLE_APP_SERVICE="sample-app"

################################################################################
# ArgoCD Applications
################################################################################

HUB_APPLICATION="hub"
SPOKE_APPLICATION="spoke"
KEYCLOAK_APPLICATION="keycloak"
VAULT_APPLICATION="vault"
SAMPLE_APPLICATION="sample-app"